# Port HTTP server ini (dipakai gateway/hosting Anda untuk expose ke publik,
# mis. reverse proxy Nginx / platform PaaS yang set PORT otomatis)
PORT=3300

# Kunci rahasia yang HARUS sama persis dengan secret
# WHATSAPP_SERVICE_API_KEY di Supabase Edge Function Secrets.
# Generate acak, contoh: `openssl rand -hex 32`
API_KEY=ganti-dengan-string-acak-yang-panjang

# Opsional: durasi status "mengetik..." (chat bubble) sebelum pesan
# benar-benar terkirim, dalam milidetik. Default 3000 (3 detik) kalau tidak
# diisi. Anti-spam kosmetik — bikin pola kirim terasa lebih natural.
TYPING_DELAY_MS=3000

# Opsional (2026-09-20): pola kirim "tidak seperti robot". Semua dalam
# milidetik kecuali yang disebut lain; nilai di bawah adalah DEFAULT-nya.
# - Jeda ACAK antara 2 pesan berurutan di antrian (4-10 detik):
MESSAGE_GAP_MIN_MS=4000
MESSAGE_GAP_MAX_MS=10000
# - Pesan tertunda (tabel wa_outbox) baru dicoba kirim ulang sekian lama
#   SETELAH koneksi tersambung (default 10 menit), bukan detik itu juga:
OUTBOX_FLUSH_DELAY_MS=600000
# - Maksimal pesan tertunda dikirim per putaran (default 10; sisanya
#   dijadwalkan putaran berikutnya otomatis):
OUTBOX_FLUSH_MAX_PER_RUN=10

# Opsional: batasi supaya endpoint /send cuma bisa dipanggil dari
# IP Supabase Edge Function kalau hosting Anda mendukung IP allowlist di
# level firewall/reverse proxy. Tidak wajib diisi di sini — API_KEY di atas
# sudah jadi lapis keamanan utama.

# --- Modul 15e: antrian retry (wa_outbox) — opsional tapi disarankan ---
# Kalau 2 var di bawah diisi, service ini otomatis coba kirim ulang
# notifikasi yang sempat gagal (mis. pas service ini down) begitu koneksi
# WhatsApp balik hidup lagi. Kalau dikosongkan, service tetap jalan normal
# seperti biasa, cuma tanpa fitur retry otomatis ini.
#
# SUPABASE_URL — sama dengan URL project Supabase project utama (`gagi/`),
# lihat Dashboard Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://tuejkpwgiqhvzjgpxrbq.supabase.co

# SUPABASE_SERVICE_ROLE_KEY — WAJIB pakai service_role key (BUKAN anon
# key), karena tabel `wa_outbox` sengaja tidak punya RLS policy sama
# sekali (lihat migration 0010_wa_outbox.sql) — cuma service_role yang
# bisa baca/tulis. Ambil dari Dashboard Supabase > Project Settings > API
# > Project API keys > service_role.
#
# PENTING: key ini setara akses admin penuh ke database Supabase Anda —
# JANGAN pernah commit ke git, JANGAN taruh di kode frontend (`/src`),
# HANYA boleh ada di `.env` service ini (server milik Anda sendiri).
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key-asli-dari-dashboard-supabase

# Opsional: berapa kali 1 pesan pending dicoba ulang sebelum ditandai
# 'failed' (berhenti di-retry otomatis) — default 5 kalau tidak diisi.
OUTBOX_MAX_ATTEMPTS=5
