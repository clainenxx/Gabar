# ── Frontend (VITE_*, boleh publik — dibaca browser, dijaga oleh RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MIDTRANS_CLIENT_KEY=
VITE_TURNSTILE_SITE_KEY=

# ── Server-only (Node script lokal / Supabase Edge Functions).
#    JANGAN PERNAH taruh nilai di bawah ini di kode /src (frontend). ──

# Supabase (dari Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (dari R2 > Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Midtrans Sandbox (dari Midtrans Dashboard > Settings > Access Keys, mode Sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# Gmail SMTP (App Password — bukan password akun Gmail biasa, lihat README §Setup Gmail)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
