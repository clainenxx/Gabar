# Contoh variabel environment untuk FRONTEND (Vite). Salin jadi `.env` lalu isi.
# Semua yang berawalan VITE_ akan ikut ter-bundle ke browser — JANGAN taruh
# secret di sini. Secret server (service role, Midtrans server key, R2,
# Turnstile secret, dst.) hanya untuk Supabase Edge Function Secrets.
# Di Netlify: isi juga di Site settings > Environment variables, lalu deploy
# ulang (Vite menanamkan nilainya saat build).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
VITE_MIDTRANS_CLIENT_KEY=<midtrans client key>

# Cloudflare Turnstile (anti-bot checkout) — SITE key, boleh publik.
# Buat di Cloudflare Dashboard > Turnstile > Add widget (domain: domain situsmu).
# Untuk development lokal bisa pakai site key uji Cloudflare yang selalu lolos:
#   1x00000000000000000000AA
# (pasangannya di server: secret uji 1x0000000000000000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=<turnstile site key>
